---
const base = import.meta.env.BASE_URL;
const target = `${base}graphics/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Graphics | Liam Maquet</title>
  </head>
  <body>
    <p><a href={target}>Open Graphics resources</a></p>
  </body>
</html>
