---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout active="Graphics" title="Graphics">
  <Hero title="Graphics" subtitle="Technical graphics, descriptive geometry and spatial reasoning" />
  <section class="container">
    <article class="card feature-card resource-card">
      <p class="eyebrow">Geometry & projection</p>
      <h2>Orthographic Projection and Auxiliary Views</h2>
      <p>Move from ordinary orthographic views to true length, point view, edge view and true shape by understanding the geometry behind auxiliary projection.</p>
      <a class="paper-link" href={`${base}graphics/orthographic-projection-auxiliary-views/`}>Read resource →</a>
    </article>
  </section>
</BaseLayout>
