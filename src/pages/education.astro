---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---
<BaseLayout active="Education" title="Education">
  <Hero title="Education" subtitle="Academic study, doctoral research and awards" />
  <section class="container">
    <div class="education-grid">
      <article class="card feature-card">
        <p class="eyebrow">2017–2021 · University of Limerick</p>
        <h2>BTech (Ed) in Materials and Engineering Technology</h2>
        <p class="credential">First Class Honours</p>
        <p>I graduated in 2021 as a secondary school teacher of Engineering, Technology, and Graphics. The programme developed advanced hand and machine skills in material processing and manufacturing, knowledge in engineering and technology, graphical principles, and pedagogical skills for teaching these areas.</p>
        <p class="muted"><strong>Selected areas:</strong> Design and communication graphics, process technology, design and technology, and foundational education studies.</p>
      </article>
      <article class="card feature-card">
        <p class="eyebrow">2021–present · TUS Midlands Midwest</p>
        <h2>PhD in Technology Education</h2>
        <p class="credential">Current study</p>
        <p>My doctoral research focuses on the development of spatial skills within secondary-level technology education. The work has included collaboration with Oide/PDST on teacher CPD and spatial-thinking training for Transition Year students across Ireland.</p>
        <p class="muted">The research also involves colleagues at Technological University Dublin and the University of Cincinnati and examines spatial-skill development and educational transfer.</p>
      </article>
    </div>
    <h2 class="section-title spaced-title">Academic awards</h2>
    <div class="education-grid">
      <article class="card award-card"><h3>President’s Doctoral Scholarship</h3><p>Technological University of the Shannon: Midlands Midwest doctoral scholarship, providing a fee waiver and annual funding for PhD study.</p></article>
      <article class="card award-card"><h3>President’s Access Scholars Award</h3><p>Awarded during fourth year of undergraduate study on the basis of achieving the highest QCA among access students in the year.</p></article>
    </div>
  </section>
</BaseLayout>
