---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import research from '../data/research.json';
const sorted = [...research].sort((a,b) => Number(b.year||0)-Number(a.year||0) || a.title.localeCompare(b.title));
---
<BaseLayout active="Research" title="Research">
  <Hero title="Research" />
  <section class="container">
    <div class="research-actions">
      <a class="button-dark" href="https://www.researchgate.net/profile/Liam-Maquet">ResearchGate</a>
      <a class="button-dark" href="https://scholar.google.com/citations?user=Nrot2nMAAAAJ&hl=en&oi=sra">Google Scholar</a>
    </div>
    <h2 class="section-title">Research outputs</h2>
    <p class="muted">Generated from ORCID during the scheduled repository workflow, with committed cached data available when ORCID is unavailable.</p>
    <div class="research-list">
      {sorted.map((item) => <article class="publication">
        <h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title} <span class="tag">{item.year || 'n.d.'}</span></h3>
        <p>{item.authors}</p><p class="muted">{item.type}</p>
      </article>)}
    </div>
  </section>
</BaseLayout>
