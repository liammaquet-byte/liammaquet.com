---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
const base = import.meta.env.BASE_URL;
const cvUrl = `${base}downloads/Liam-Maquet-CV.pdf`;
---
<BaseLayout active="Curriculum Vitae" title="Curriculum Vitae">
  <Hero title="Curriculum Vitae" subtitle="Academic experience, education and professional practice" />
  <section class="container">
    <div class="page-intro card">
      <div>
        <p class="eyebrow">Curriculum Vitae</p>
        <h2>Full academic & professional CV</h2>
        <p class="muted">The document below is the current CV. Use the full-view control to open it in a dedicated browser tab.</p>
      </div>
      <a class="button-dark" href={cvUrl} target="_blank" rel="noopener">View full CV ↗</a>
    </div>
    <div class="pdf-shell">
      <iframe src={`${cvUrl}#view=FitH&toolbar=1&navpanes=0`} title="Liam Maquet curriculum vitae"></iframe>
      <p class="pdf-fallback">If your browser does not display embedded PDFs, <a href={cvUrl} target="_blank" rel="noopener">open the CV in full view</a>.</p>
    </div>
  </section>
</BaseLayout>
