const base = import.meta.env.BASE_URL;
const entries = [{"title": "Home", "path": "", "section": "Site", "text": "Liam Maquet Assistant Professor Technology Education University of Limerick overview academic profiles contact"}, {"title": "Curriculum Vitae", "path": "cv/", "section": "Profile", "text": "Academic professional CV experience education Assistant Professor University Teacher Teaching Assistant PhD"}, {"title": "Education", "path": "education/", "section": "Profile", "text": "BTech Ed Materials Engineering Technology PhD Technology Education academic awards scholarship University of Limerick TUS"}, {"title": "Research", "path": "research/", "section": "Research", "text": "Research outputs spatial skills design thinking technology education ORCID publications guest lectures presentations"}, {"title": "Teaching", "path": "teaching/", "section": "Teaching", "text": "Third level teaching experience CPD Oide PDST professional learning certificates student evaluation teaching"}, {"title": "First Year Teaching", "path": "first-year-teaching/", "section": "Teaching", "text": "Advice resources graduates first year teaching classroom"}, {"title": "Graphics", "path": "graphics/", "section": "Graphics", "text": "Technical graphics descriptive geometry spatial reasoning resources"}, {"title": "Orthographic Projection and Auxiliary Views", "path": "graphics/orthographic-projection-auxiliary-views/", "section": "Graphics", "text": "orthographic projection first-angle projection foreshortening auxiliary views true length point view edge view true shape oblique surface descriptive geometry"}, {"title": "Tools", "path": "tools/", "section": "Tools", "text": "QCA calculator QR code generator browser tools"}, {"title": "QCA Calculator", "path": "qca-calculator/", "section": "Tools", "text": "QCA QCS calculator grades credits semester residual QCA"}, {"title": "QR Code Generator", "path": "qr-code-generator/", "section": "Tools", "text": "QR code generator text URL size colour background PNG copy"}, {"title": "Sheet Nester", "path": "tools/sheet-nester/", "section": "Tools", "text": "sheet nesting rectangular parts DXF DWG profiles stock sheet fabrication cutting layout export DXF local browser"}, {"title": "Decoding Design Thinking: Deepening the Lens on Values and Capabilities", "path": "research/", "section": "Research · 2026", "text": "Decoding Design Thinking: Deepening the Lens on Values and Capabilities Liam Maquet; Rónán Dunbar; Jeffrey Buckley Conference paper PATT43: The 43rd International Pupils’ Attitudes Towards Technology Research Conference 2026"}, {"title": "Decoding Design Thinking: Common Threads for Technology Education", "path": "research/", "section": "Research · 2025", "text": "Decoding Design Thinking: Common Threads for Technology Education Liam Maquet; Rónán Dunbar; Jeffrey Buckley Conference paper  2025"}, {"title": "Does Medium Matter? Exploring Validity in Paper and Digital Spatial Ability Tests in Secondary Education", "path": "research/", "section": "Research · 2024", "text": "Does Medium Matter? Exploring Validity in Paper and Digital Spatial Ability Tests in Secondary Education Liam Maquet; Rónán Dunbar; Jeffrey Buckley Conference paper PATT41: The 41st International Pupils’ Attitudes Towards Technology Research Conference 2024"}, {"title": "Spatial Thinking and STEM: A Study on the Development and Transfer of Spatial Skills in Irish Education", "path": "research/", "section": "Research · 2024", "text": "Spatial Thinking and STEM: A Study on the Development and Transfer of Spatial Skills in Irish Education Liam Maquet; Jeffrey Buckley; Rónán Dunbar; Gavin Duffy; Sheryl A. Sorby Conference poster  2024"}, {"title": "The Impact of an Intervention for Improving Spatial Cognition Among Adolescents", "path": "research/", "section": "Research · 2024", "text": "The Impact of an Intervention for Improving Spatial Cognition Among Adolescents Liam Maquet; Gavin Duffy; Sheryl A. Sorby; Rónán Dunbar Conference abstract  2024"}, {"title": "Developing Spatial Thinking in TY", "path": "research/", "section": "Research · 2023", "text": "Developing Spatial Thinking in TY Gavin Duffy; Sheryl A. Sorby; A. Dwane; Liam Maquet Technical report Oide 2023"}, {"title": "Implementation and analysis of a spatial skills course for Secondary level STEM education", "path": "research/", "section": "Research · 2023", "text": "Implementation and analysis of a spatial skills course for Secondary level STEM education Ursa Benedicic; Liam Maquet; Gavin Duffy; Rónán Dunbar; Jeffrey Buckley; Sheryl A. Sorby Conference paper The 40th International Pupils’ Attitudes Towards Technology Conference 2023"}, {"title": "A Review of The Literature To Inform the Efficacy of a Spatial Skills Intervention For Secondary Level STEM Education", "path": "research/", "section": "Research · 2022", "text": "A Review of The Literature To Inform the Efficacy of a Spatial Skills Intervention For Secondary Level STEM Education Liam Maquet; Rónán Dunbar; Jeffrey Buckley; Niall Seery; Sheryl A. Sorby Conference paper  2022"}];
---
<BaseLayout active="Search" title="Search">
  <Hero title="Search" subtitle="Search pages, resources, tools and research outputs" />
  <section class="container search-page">
    <div class="search-box card">
      <label for="site-search">Search this site</label>
      <div class="search-input-row">
        <input id="site-search" type="search" placeholder="Try “auxiliary views”, “QCA” or a publication title…" autocomplete="off" />
        <button id="search-button" class="button-dark" type="button">Search</button>
      </div>
    </div>
    <p id="search-summary" class="muted"></p>
    <div id="search-results" class="search-results"></div>
  </section>
  <script is:inline define:vars={{ entries, base }}>
    const input = document.getElementById('site-search');
    const button = document.getElementById('search-button');
    const results = document.getElementById('search-results');
    const summary = document.getElementById('search-summary');

    const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    function runSearch() {
      const q = input.value.trim().toLowerCase();
      const params = new URLSearchParams(location.search);
      if (q) params.set('q', input.value.trim()); else params.delete('q');
      history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params : ''));
      if (!q) {
        summary.textContent = 'Enter a word or phrase to search the site.';
        results.innerHTML = '';
        return;
      }
      const terms = q.split(/\s+/).filter(Boolean);
      const matches = entries.map(entry => {
        const hay = `${entry.title} ${entry.section} ${entry.text}`.toLowerCase();
        const score = terms.reduce((n,t) => n + (hay.includes(t) ? 1 : 0), 0);
        return {entry, score};
      }).filter(x => x.score === terms.length)
        .sort((a,b) => b.score-a.score || a.entry.title.localeCompare(b.entry.title));
      summary.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} for “${input.value.trim()}”`;
      results.innerHTML = matches.map(({entry}) => `
        <a class="card search-result" href="${base}${entry.path}">
          <span class="eyebrow">${esc(entry.section)}</span>
          <strong>${esc(entry.title)}</strong>
          <span class="muted">${esc(entry.text.slice(0,180))}${entry.text.length > 180 ? '…' : ''}</span>
        </a>`).join('');
    }
    button.addEventListener('click', runSearch);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') runSearch(); });
    input.addEventListener('input', () => { if (!input.value.trim()) runSearch(); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) input.value = initial;
    runSearch();
  </script>
</BaseLayout>
