---
import '../styles/global.css';
const { title = 'Graphics', description = 'Technical graphics, descriptive geometry and spatial reasoning', active = 'Graphics' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title} | Liam Maquet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header graphics-only-header">
      <a class="brand" href={`${base}graphics/`} aria-label="Liam Maquet Graphics">
        <span class="brand-mark">LM</span><span class="brand-name">LIAM MAQUET</span>
      </a>
      <nav class="main-nav graphics-only-nav" aria-label="Primary">
        <a class:list={{active: active==='Graphics'}} href={`${base}graphics/`}>Graphics</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer graphics-only-footer">
      <p>© {new Date().getFullYear()} Liam Maquet</p>
      <div><a href={`${base}graphics/`}>Graphics resources</a></div>
    </footer>
  </body>
</html>
