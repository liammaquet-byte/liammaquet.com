---
import '../styles/global.css';
const { title = 'Tool', description = 'Browser-based tool' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090909" />
    <title>{title} | Liam Maquet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="tool-site-bar">
      <div class="tool-site-bar-inner">
        <a class="tool-site-brand" href={`${base}tools/`} aria-label="Back to Tools">
          <span class="tool-site-mark">LM</span>
          <span>LIAM MAQUET · TOOLS</span>
        </a>
        <a class="tool-site-back" href={`${base}tools/`}>← Back to Tools</a>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>
